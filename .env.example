# Application
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Database
POSTGRES_DB=career_network
POSTGRES_USER=career_network
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://career_network:change-me@localhost:5432/career_network

# Backend security and CORS
SESSION_COOKIE_NAME=career_network_session
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=false
TRUSTED_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional integrations (Phase 4+)
GITHUB_TOKEN=
LLM_PROVIDER=
LLM_API_KEY=
